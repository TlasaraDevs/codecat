# Copy to .env (never commit .env). All values here are optional.
#
# Phase 2 (Supabase) will add its public client values here, e.g.:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_public_anon_key
#
# Only ever put PUBLIC, client-side values in VITE_* variables — they are
# baked into the static bundle and visible to anyone.
