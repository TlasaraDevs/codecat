# Apache config for the static build (Host Africa / DirectAdmin).
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # This folder is public_html/codecat/ inside the main site, so the same
  # files are also reachable at tlasara.dev/codecat/ (and any other host
  # pointing here). Send every host except the subdomain to the canonical
  # URL, keeping the path: tlasara.dev/codecat/blog/x →
  # https://codecat.tlasara.dev/blog/x. The query string is kept too.
  RewriteCond %{HTTP_HOST} !^codecat\.tlasara\.dev(:[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://codecat.tlasara.dev/$1 [R=301,L]

  # (tlasara.dev/codecat without the trailing slash is handled by the
  # RedirectMatch below, before Apache would add the slash itself.)

  # Uncomment to force HTTPS once the subdomain's SSL certificate is active.
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Client-side routes the app knows about are served by index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog(/.*)?$ index.html [L]
</IfModule>

# Rewrite rules never see this folder's own URL without its trailing slash, so
# Apache would first redirect tlasara.dev/codecat → http://tlasara.dev/codecat/.
# Go straight to the subdomain instead, in one hop.
<IfModule mod_alias.c>
  <If "%{HTTP_HOST} !~ /^codecat\.tlasara\.dev(:[0-9]+)?$/i">
    RedirectMatch 301 ^/codecat$ https://codecat.tlasara.dev/
  </If>
</IfModule>

# The FTP deploy keeps a state file listing every uploaded file; don't serve it.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Anything else that doesn't exist gets the app (which shows the comic 404
# page) with a real 404 status, so search engines don't index it.
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  # Other images (profile photo, screenshots, OG image): cache for a day.
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|txt|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Vite's hashed build files (name-AbC123xy.ext) never change; cache for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate the HTML so new deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
